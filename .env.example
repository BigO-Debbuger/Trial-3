# Fortress AI — Environment Variables

# OpenAI API Key (required for LLM-enhanced AI strategy)
# Get yours at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-key-here

# Swytchcode credentials (optional, auto-configured via npx swytchcode)
# SWYTCHCODE_TOKEN=

# Server port
PORT=3001

# Enable/disable LLM AI (set to 'false' for deterministic-only AI)
ENABLE_LLM_AI=true
